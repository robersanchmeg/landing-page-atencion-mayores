datasource db {
	provider = "postgresql"
}

generator client {
	provider = "prisma-client-js"
}

enum ServicioContacto {
	hours
	night
	medical
	dependency
}

model Contacto {
	id        String   @id @default(cuid())
	nombre    String
	telefono  String
	zona      String
	servicio  ServicioContacto
	createdAt DateTime @default(now())
}

model Candidatura {
	id               String   @id @default(cuid())
	nombre           String
	telefono         String
	email            String
	mensaje          String
	cvNombre         String
	cv               Bytes
	consentimientoEn DateTime @default(now())
	createdAt        DateTime @default(now())
}